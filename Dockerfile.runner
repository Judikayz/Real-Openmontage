# Execution image for GitHub Actions runners. Repo code is bind-mounted at /work at run time
# (so the latest commit always runs); this image only carries slow-to-install dependencies.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 PYTHONPATH=/work

# ffmpeg + git + Chromium runtime libs (Remotion/HyperFrames render with headless Chrome)
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git curl ca-certificates gnupg xz-utils fonts-liberation \
      libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 libasound2 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxkbcommon0 libpango-1.0-0 libcairo2 \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# OpenCode, pinned to the version the runner's CLI flags were verified against.
ARG OPENCODE_VERSION=1.19.5
RUN npm install -g opencode-ai@${OPENCODE_VERSION} && opencode --version

WORKDIR /opt/deps
COPY requirements.txt requirements-runner.txt ./
RUN pip install -r requirements.txt -r requirements-runner.txt

WORKDIR /work
CMD ["python", "-m", "runner.run_job"]
