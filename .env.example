# ===== Backend (persistent API; deploy anywhere that runs Python + stays up) =====
ORCH_ENABLE=1                          # mounts the orchestrator API inside Backlot
ORCH_ADMIN_TOKEN=                      # long random string; you log in to Backlot with this
ORCH_RUNNER_SECRET=                    # long random string; MUST equal the GitHub Actions secret of the same name
ORCH_SESSION_SECRET=                   # optional; signs session cookies (defaults to ORCH_ADMIN_TOKEN)
ORCH_PUBLIC_URL=                       # public https URL of this backend (runners call back to it)
ORCH_ALLOWED_HOSTS=                    # comma-separated Host headers allowed, e.g. backlot.example.com
ORCH_DB_PATH=.orchestrator/orchestrator.db
ORCH_MAX_UPLOAD_BYTES=2147483648

# ===== Object storage: S3-compatible (Cloudflare R2 recommended) =====
ORCH_STORAGE=s3                        # "local" is for development/tests only
S3_ENDPOINT=                           # https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                         # bucket needs a CORS rule allowing PUT/GET from your Backlot origin

# ===== GitHub Actions dispatch (server-side only; never in the browser) =====
ORCH_DISPATCH_MODE=github              # "local" runs the runner as a subprocess: development only
GITHUB_DISPATCH_REPO=                  # owner/name, e.g. Judikayz/Real-Openmontage
GITHUB_DISPATCH_REF=main
GITHUB_DISPATCH_WORKFLOW=opencode-run.yml
GITHUB_DISPATCH_TOKEN=                 # fine-grained PAT: this repo only; Actions: read+write (dispatch/cancel), Secrets: read+write (optional settings page)

# ===== Optional Telegram notifications =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== GitHub repository SECRETS (Settings -> Secrets and variables -> Actions) =====
# ORCH_RUNNER_SECRET   (required, same value as above)
# OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / GROQ_API_KEY ...  (whichever OpenCode provider you use)
# ELEVENLABS_API_KEY, FAL_KEY, PEXELS_API_KEY, PIXABAY_API_KEY, HEYGEN_API_KEY, RUNWAY_API_KEY ...  (only the OpenMontage tools you use)
# GitHub repository VARIABLE:  ORCH_BACKEND_URL  (same as ORCH_PUBLIC_URL; used by Recovery and Health Check)
